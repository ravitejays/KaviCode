/* Kavi terminal UI theme (by Bahumukh AI). */

Screen {
    background: #000000;
    layers: base overlay;
}

#chat {
    height: 1fr;
    padding: 0 1;
    background: #000000;
    scrollbar-size-vertical: 1;
}

.msg {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1;
}

.msg-user {
    color: $text;
    background: #161b22;
    margin: 1 0;
    padding: 1 2;
}

.msg-assistant {
    color: $text;
    padding: 0 1;
}

.msg-thinking {
    color: $text-muted;
    text-style: italic;
    border-left: wide $warning;
    padding: 0 1;
}

.msg-notice {
    color: $text-muted;
    text-style: italic;
}

.msg-stats {
    color: #484f58;
    text-style: italic;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
}

.tool-card {
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
}

.tool-card.-error {
    /* error rows colour themselves inline (red branch); no box needed */
}

.todo-list {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    border-left: wide #3fb950;
}

#working {
    height: 1;
    margin: 0 1;
    color: #3fb950;
    display: none;
}

#working.-active {
    display: block;
}

.tool-title {
    text-style: bold;
    color: $secondary;
}

.tool-body {
    color: $text-muted;
}

.welcome {
    width: auto;
    height: auto;
    margin: 0 0 1 0;
}

#bottom-bar {
    dock: bottom;
    height: auto;
    background: #000000;
}

#suggest {
    height: auto;
    max-height: 10;
    margin: 0 1;
    padding: 0;
    border: round #3fb950;
    background: $panel;
    scrollbar-size-vertical: 1;
}

#suggest > .option-list--option {
    padding: 0 1;
}

#suggest > .option-list--option-highlighted {
    background: #3fb950 30%;
    color: $text;
}

#mode-line {
    height: 1;
    background: #000000;
    color: $text-muted;
    text-align: right;
    padding: 0 2;
}

#prompt-row {
    height: auto;
    min-height: 3;
    max-height: 12;
    margin: 0;
    padding: 0 2;
    background: #000000;
    border-top: solid #21262d;
    border-bottom: solid #21262d;
}

#prompt-arrow {
    width: 3;
    height: 100%;
    color: $text-muted;
    text-style: bold;
    padding: 0 0 0 0;
    background: #000000;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 12;
    border: none;
    background: #000000;
    padding: 0;
}

#prompt:focus {
    border: none;
}

StatusBar {
    height: 2;
    background: $surface;
    color: $text-muted;
    padding: 0 2;
}

PermissionDialog {
    align: center middle;
}

#perm-box {
    width: 70%;
    max-width: 90;
    height: auto;
    border: thick $warning;
    background: $panel;
    padding: 1 2;
}

#perm-title {
    text-style: bold;
    color: $warning;
    margin: 0 0 1 0;
}

#perm-subject {
    color: $text;
    margin: 0 0 1 0;
}

#perm-buttons {
    height: auto;
    align: center middle;
}

#perm-buttons Button {
    margin: 0 1;
}

SelectionScreen {
    align: center middle;
}

#select-box {
    width: 70%;
    max-width: 90;
    height: auto;
    max-height: 80%;
    border: round #3fb950;
    background: $panel;
    padding: 1 2;
}

#select-title {
    text-style: bold;
    color: #3fb950;
    margin: 0 0 1 0;
}

#select-filter {
    height: 3;
    border: round #3fb950;
    margin: 0 0 1 0;
}

#select-list {
    height: auto;
    max-height: 16;
    border: none;
    background: $panel;
    scrollbar-size-vertical: 1;
}

#select-list > .option-list--option {
    padding: 0 1;
}

#select-list > .option-list--option-highlighted {
    background: #3fb950 30%;
    color: $text;
}

#select-hint {
    color: $text-muted;
    margin: 1 0 0 0;
}

ApiKeyPromptScreen {
    align: center middle;
}

#key-box {
    width: 70%;
    max-width: 80;
    height: auto;
    border: round #3fb950;
    background: $panel;
    padding: 1 2;
}

#key-title {
    text-style: bold;
    color: #3fb950;
    margin: 0 0 1 0;
}

#key-sub {
    color: $text-muted;
    margin: 0 0 1 0;
}

#key-input {
    height: 3;
    border: round #3fb950;
}

#key-hint {
    color: $text-muted;
    margin: 1 0 0 0;
}
